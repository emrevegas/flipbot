# Ada license bot — COPY to ada.env (do not commit)

ADA_BOT_TOKEN=your_ada_bot_discord_token
OWNER_ID=123456789012345678

# Ed25519 license signing (generate: python licensing/control/generate_keys.py)
LICENSE_PRIVATE_KEY_PATH=licensing/control/license_private.pem
# Or paste PEM (use \n for newlines):
# LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...

# Encrypt VDS passwords in SQLite (optional; falls back to LICENSE_SIGNING_SECRET)
LICENSE_DB_ENCRYPTION_KEY=random-long-secret
ADA_LICENSE_DB_PATH=data/ada_license.db

# GitHub — /build triggers workflow; releases uploaded to separate repo
GITHUB_TOKEN=ghp_...
GITHUB_SOURCE_REPO=youruser/flipbot
GITHUB_BUILD_WORKFLOW=build-release.yml
GITHUB_BUILD_REF=master
RELEASES_GITHUB_REPO=youruser/flipbot-releases

# Shop prices (balance currency)
BALANCE_PRICE_DAILY=5
BALANCE_PRICE_WEEKLY=25
BALANCE_PRICE_MONTHLY=80

# Background license sync to customer VDS (seconds)
LICENSE_SYNC_INTERVAL=300
